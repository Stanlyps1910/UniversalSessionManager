# Turso Database (required for Netlify deployment)
# Create a free database at https://turso.tech
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# AI Provider API Keys (optional - can also be added via Settings UI)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# MISTRAL_API_KEY=
